SUPABASE_URL=https://seu-projeto.supabase.co
# Chave privada, apenas no servidor. Alternativa legada: SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
JWT_SECRET=
PORT=3000
# Em hospedagem HTTPS, use production para cookies Secure e HSTS.
NODE_ENV=development

# Número de proxies controlados antes do Express (0 se acesso direto).
TRUST_PROXY_HOPS=0

# Mercado Pago: deixe em branco quando PAYMENT_PROVIDER=infinitepay.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SANDBOX=false

# URL pública usada pelo webhook e retorno de pagamento.
PUBLIC_BASE_URL=https://seu-dominio.com.br

# InfinitePay.
PAYMENT_PROVIDER=infinitepay
INFINITEPAY_HANDLE=

# Origem da loja: Rua Javari, 2705, Ipiranga, Ribeirão Preto/SP.
STORE_LATITUDE=-21.1391875
STORE_LONGITUDE=-47.8211875
DELIVERY_PRICE_PER_KM=1.50
DELIVERY_CHARGE_MODE=excedente
OSRM_BASE_URL=https://router.project-osrm.org
