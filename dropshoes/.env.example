SUPABASE_URL=https://seu-projeto.supabase.co
# Chave privada, apenas no servidor. Alternativa legada: SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
JWT_SECRET=
PORT=3000
# Em hospedagem HTTPS, use production para cookies Secure e HSTS.
NODE_ENV=development

# Número de proxies controlados antes do Express (0 se acesso direto).
TRUST_PROXY_HOPS=0

# Checkout Pro: configurar notificações "payment" no painel Mercado Pago.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
MERCADOPAGO_SANDBOX=false

# InfinitePay (use PAYMENT_PROVIDER=infinitepay para ativar o checkout).
PAYMENT_PROVIDER=mercadopago
INFINITEPAY_HANDLE=

# Origem: Plus Code 58CJV56H+8G (V56H+8G, Ribeirão Preto).
STORE_LATITUDE=-21.1391875
STORE_LONGITUDE=-47.8211875
DELIVERY_PRICE_PER_KM=1.50
DELIVERY_CHARGE_MODE=excedente
# Servidor público de demonstração. Use uma instância/provedor adequado em produção.
OSRM_BASE_URL=https://router.project-osrm.org
